<Window x:Class="Part_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Part_2"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Chat Application"
        Width="1000"
        Height="500"
        Background="#FF454444"
        Foreground="{DynamicResource Theme_TextBrush}">

    <!-- Outer Pink Border -->
    <Border Margin="164,0,0,0"
            Width="721"
            Height="422"
            CornerRadius="10"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Background="#FFFF3BA0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform AngleY="0.139"/>
                <RotateTransform/>
                <TranslateTransform Y="0.761"/>
            </TransformGroup>
        </Border.RenderTransform>

        <!-- Main Chat Container -->
        <Grid Width="447"
              Height="324"
              Background="#FFDEDBDB">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="Chat"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#FFFF3BA0"
                       Margin="10"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>

            <!-- Chat Area -->
            <Border Grid.Row="1"
                    Margin="10,0,10,50"
                    Background="White"
                    CornerRadius="12">

                <ScrollViewer x:Name="chatScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="chatPanel"
                                Margin="10"/>
                </ScrollViewer>
            </Border>

            <!-- Input TextBox -->
            <Border Grid.Row="1"
                    Width="320"
                    Height="32"
                    CornerRadius="16"
                    Background="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="10,0,0,10">

                <TextBox x:Name="User_input"
                         Text="Type your message"
                         Foreground="#FF575757"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="10,5"
                         VerticalContentAlignment="Center"/>
            </Border>

            <!-- Send Button -->
            <Border Grid.Row="1"
                    Width="88"
                    Height="32"
                    CornerRadius="16"
                    Background="#FFFF3BA0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,10,10">

                <Button x:Name="Button1"
                        Content="Send"
                        Click="SendText"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"/>
            </Border>

        </Grid>
    </Border>
</Window>
